{
  "name": "local-mifit",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "dsh-go 手机 App 原生插件：自带扫码登录、取数和面板的小米运动健康数据",
  "keywords": ["dsh-go", "dsh-go-plugin", "mifit", "xiaomi", "health"],
  "repository": {
    "type": "git",
    "url": "https://github.com/luotong2333-web/dsh-go-plugin-mifit.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": { "zh": "小米健康", "en": "Mi Fitness" },
    "icon": "heart",
    "contributes": {
      "panels": [
        {
          "id": "mifit",
          "title": { "zh": "小米健康", "en": "Mi Fitness" },
          "icon": "heart",
          "placement": ["features"]
        }
      ]
    }
  }
